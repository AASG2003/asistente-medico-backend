# Copy this file to .env and fill in your values. Never commit .env.

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=America/La_Paz

# Database: leave unset to use backend/db.sqlite3.
# PostgreSQL example (requires `pip install "psycopg[binary]"`):
# DATABASE_URL=postgres://user:password@localhost:5432/health_tracker

# LLM: "fake" works offline, "gemma" calls the Gemini API.
LLM_PROVIDER=fake
LLM_MODEL=gemma-4-26b-a4b-it
# Create a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# minimal | high (Gemma accepts only these). minimal is ~5x faster; empty uses the model default.
LLM_THINKING_LEVEL=minimal
